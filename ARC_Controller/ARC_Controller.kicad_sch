	(text "Need a small inductor (L1) and capacitor\nto maintain inductor saturation current\nhigher than the charging current (3 A)\nplus half the ripple current (I_ripple)\nf = 1.5 MHz\n\nI_SAT >= I_CHG + (1/2)I_RIPPLE\n\nD = V_BAT / V_VBUS\nD = 4.2 / 12 = 0.35 (35% duty cycle)\n\nI_RIPPLE = [V_VBUS * D * (1-D)] / (f_s * L)\nI_RIPPLE = [12V * 0.35 * (1-0.35)] / (1.5 MHz * 1.0 uH)\nI_RIPPLE = 1.82 Amps\n\nI_SAT >= 3A + (0.5 * 1.82A)\nI_SAT >= 3.91 Amps\n1.0 uH shielded power inductor with a\nsaturation current rating of at least\n4.5A - 5A.\n"
		(exclude_from_sim no)
		(at 196.85 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8599d217-658f-41a9-ae9f-0f620d04edb4")
	)
	(text "I_CHG = K_ICHG / R_ICHG, typical K value\nof 677 A*Ohm Range 639-715 A*Ohm"
		(exclude_from_sim no)
		(at 264.668 129.032 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "acf1a01c-4c35-4f8b-90a4-d778f1f33b48")
	)
	(text "I_LIM = K_ILIM / R_ILIM, typical K value\nof 478 A*Ohm Range 459-500 A*Ohm"
		(exclude_from_sim no)
		(at 263.652 123.698 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "dafa3376-7be0-4e21-8a69-744b461392aa")
	)
